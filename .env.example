# Copy to .env. Both values have defaults in config.ts, so .env is optional.

# Port the relay (server.ts) listens on.
WS_PORT=8080

# URL Node clients dial. Defaults to ws://localhost:${WS_PORT} if unset.
WS_URL=ws://localhost:8080

# URL the browser build dials. Must be VITE_-prefixed to reach client code.
VITE_WS_URL=ws://localhost:8080
